{
  "name": "tiktok-downloader-backend",
  "version": "1.0.0",
  "description": "Backend API for TikTok video downloader",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.tikdown.auto",
    "productName": "TikDown Auto",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!temp/**/*",
      "!.git/**/*",
      "!.idea/**/*"
    ]
  },
  "keywords": [
    "tiktok",
    "downloader",
    "api",
    "electron"
  ],
  "author": "TikDown Team",
  "license": "MIT",
  "dependencies": {
    "@mrnima/facebook-downloader": "^1.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "puppeteer": "^24.35.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tiktok-scraper-without-watermark": "^1.1.3",
    "youtube-dl-exec": "^3.0.28",
    "ytdl-core": "^4.11.5",
    "ytdlp-nodejs": "^2.3.5"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "nodemon": "^3.0.1"
  }
}